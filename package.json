{
  "name": "sunil-enterprises",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build && node scripts/prepare-pwa.mjs",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test server/*.test.js",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "owner:create": "node scripts/admin.mjs create",
    "owner:reset": "node scripts/admin.mjs reset",
    "backup": "node scripts/backup.mjs create",
    "backup:check": "node scripts/backup.mjs check",
    "backup:restore": "node scripts/backup.mjs restore",
    "test:container": "node scripts/container-smoke.mjs",
    "test:mongo": "node scripts/mongo-tests.mjs",
    "test:photo-browser": "npm run build && node scripts/photo-browser-smoke.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.21.0",
    "pdfkit": "^0.20.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "playwright": "^1.61.0",
    "vite": "^7.1.0"
  }
}
