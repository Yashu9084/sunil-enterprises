# This file is documentation. The server reads process environment; it does not load .env.
# Docker Compose reads .env for interpolation. Never commit .env or real credentials.
PORT=3000
DATA_DIR=./data
# Only use 1 behind exactly one trusted reverse proxy.
TRUST_PROXY=0
# Set a long random private SETUP_TOKEN in deployment settings, or bootstrap via admin CLI.
# SETUP_TOKEN=
# Set BACKUP_PASSPHRASE securely for scheduled/offline backup commands. Never lose it.
# BACKUP_PASSPHRASE=
# Set APP_DOMAIN to your owned domain when public deployment is authorized.
# APP_DOMAIN=
