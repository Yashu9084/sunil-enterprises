# This file is documentation. The server reads process environment; it does not load .env.
# Docker Compose reads .env for interpolation. Never commit .env or real credentials.
PORT=3000
DATA_DIR=./data
# Only use 1 behind exactly one trusted reverse proxy.
TRUST_PROXY=0
# Set a long random private SETUP_TOKEN in deployment settings, or bootstrap via admin CLI.
# SETUP_TOKEN=
# Set BACKUP_PASSPHRASE securely for scheduled/offline backup commands. Never lose it.
# BACKUP_PASSPHRASE=
# Set APP_DOMAIN to your owned domain when public deployment is authorized.
# APP_DOMAIN=

# Render/Atlas: set these privately in Render, never in Git or chat.
# Render Blueprint requires MongoDB and refuses an ephemeral-only ledger.
# STORAGE_BACKEND=mongodb
# MONGODB_URI=mongodb+srv://USER:URL_ENCODED_PASSWORD@CLUSTER/?retryWrites=true&w=majority
# MONGODB_DB=sunil_enterprises

# Optional handwriting reader. Server-side only; API billing is separate from hosting.
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4.1
